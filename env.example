# ========================================================
# ShieldScan v2.0 — Variables de entorno
# Copiar a .env y ajustar valores antes de ejecutar
# ========================================================

# Base de datos PostgreSQL
DB_PASSWORD=shieldscan_secure_password

# JWT Secret (cambiar por un valor seguro en producción)
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# URLs internas (solo para desarrollo local fuera de Docker)
DATABASE_URL=postgresql://shieldscan:shieldscan@localhost:5432/shieldscan
REDIS_URL=redis://localhost:6379/0

# Servidor legacy (servicios/api reemplaza esto en la arquitectura nueva)
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Docker Hub (configurar como GitHub Secrets en el pipeline)
DOCKER_HUB_USER=migueldevsec
DOCKER_HUB_PASSWORD=your-docker-hub-password-or-token

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
